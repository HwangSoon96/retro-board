<?xml version="1.0" encoding="UTF-8" ?>
<!-- SQL문 넣어놓는 맵퍼 파일 -->
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hs.mybatis.CryptMapper"> <!-- namespace의 경우, 맵퍼 여러 개 사용할 경우 중복될 수 있기 때문에 고유한 이름을 지어주는 것. -->
    
    <select id="dataCrypt" resultType="cryptVO"> <!-- typeAlias -->
    	select * from crypt<!-- 게시물 번호 내림차순으로 가져온다. -->
    </select>
    
</mapper>